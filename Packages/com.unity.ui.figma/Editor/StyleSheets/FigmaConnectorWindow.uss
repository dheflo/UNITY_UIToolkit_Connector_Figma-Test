:root {
    --figma-accent: #0A6EC8;
    --figma-success: #3FB950;
    --figma-warning: #D9A000;
    --figma-error: #F85149;
}

.figma-status-row {
    flex-direction: row;
    align-items: center;
}

.figma-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--unity-colors-label-text);
}
.figma-dot--ok { background-color: var(--figma-success); }
.figma-dot--warn { background-color: var(--figma-warning); }
.figma-dot--err { background-color: var(--figma-error); }

.figma-port {
    margin-left: 6px;
    opacity: 0.7;
}

.figma-spacer {
    flex-grow: 1;
}

.figma-conn {
    background-color: var(--unity-colors-inspector_titlebar-background);
    padding: 6px 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
}

.figma-map-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.figma-pair {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 110, 200, 0.12);
    border-width: 1px;
    border-color: var(--figma-accent);
    border-radius: 4px;
    padding: 8px;
    margin: 0 6px 8px 6px;
}
.figma-pair-text { flex-grow: 1; }
.figma-pair-countdown { color: var(--figma-warning); margin-top: 2px; }

.figma-header-meta {
    opacity: 0.6;
    font-size: 11px;
    margin-left: 6px;
    -unity-text-align: middle-right;
}
.figma-insync { color: var(--figma-success); }

.figma-import-group {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 2px;
}

.unity-foldout.figma-file-group {
    border-bottom-width: 0;
    margin-top: 4px;
}
.figma-file-group > .unity-foldout__toggle {
    background-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-top: 0;
    margin-bottom: 0;
}
.figma-file-group > .unity-foldout__content {
    padding-top: 2px;
    padding-bottom: 4px;
}
.figma-group-push {
    -unity-font-style: normal;
    margin: 0 0 0 6px;
    padding: 0 8px;
    flex-shrink: 0;
}
.figma-group-waiting {
    -unity-font-style: italic;
    font-size: 11px;
    opacity: 0.6;
    margin: 0 0 0 6px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.figma-change-line {
    white-space: normal;
    opacity: 0.85;
}

.figma-note-list {
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 2px;
    margin-top: 2px;
}
.figma-note-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}
.figma-note-ic {
    width: 16px;
    height: 16px;
    margin-right: 7px;
    flex-shrink: 0;
}
.figma-note-title {
    flex-grow: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.figma-note-footer {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
}
.figma-note-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}
.figma-note-cic {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.unity-foldout__toggle {
    background-color: var(--unity-colors-inspector_titlebar-background);
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 0;
    margin-bottom: 0;
}
.unity-foldout {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}
.unity-foldout__content {
    margin-left: 8px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 8px;
}
