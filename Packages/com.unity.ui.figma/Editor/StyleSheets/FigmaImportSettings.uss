.figma-spacer { flex-grow: 1; }
.figma-muted { opacity: 0.6; }

.figma-fold-hint {
    opacity: 0.6;
    font-size: 11px;
    margin-right: 4px;
    -unity-text-align: middle-right;
}

.figma-fs-subtitle {
    opacity: 0.7;
    white-space: normal;
    margin-bottom: 8px;
}

.figma-headerrow {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.figma-headerrow > .unity-label { margin-right: 6px; }
.figma-count {
    opacity: 0.6;
    font-size: 11px;
    margin-right: 6px;
}
.figma-section-title {
    -unity-font-style: bold;
    font-size: 13px;
}
.figma-prop-title {
    -unity-font-style: bold;
    font-size: 12px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.figma-fs-fold {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 8px;
    margin-bottom: 12px;
}
.figma-fs-fold > .unity-foldout__toggle {
    background-color: var(--unity-colors-inspector_titlebar-background);
    -unity-font-style: bold;
    margin: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
}
.figma-fs-fold > .unity-foldout__content {
    margin-left: 0;
    padding: 10px 12px 12px 12px;
}

.figma-inline-list {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 2px;
    padding: 6px;
    margin-bottom: 10px;
}
.figma-inline-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}
.figma-inline-row > .unity-base-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 6px 0 0;
}
.figma-inline-row .unity-base-text-field__input {
    min-width: 0;
}
.figma-empty {
    opacity: 0.6;
    font-size: 11px;
    padding: 2px;
}

.figma-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.figma-toolbar > .unity-toolbar-search-field { flex-grow: 1; margin: 0 8px 0 0; }

.figma-cm-row {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 6px;
}
.figma-cm-row > .unity-foldout__toggle {
    background-color: var(--unity-colors-inspector_titlebar-background);
    margin: 0;
    padding: 4px 8px;
    min-height: 30px;
}
.figma-cm-row > .unity-foldout__toggle:hover {
    background-color: var(--unity-colors-inspector_titlebar-background-hover);
}
.figma-cm-row > .unity-foldout__toggle .unity-toggle__input {
    align-items: center;
}
.figma-cm-row > .unity-foldout__content {
    margin-left: 0;
    padding: 10px 12px;
}
.figma-cm-name {
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 0;
    flex-shrink: 1;
}
.figma-cm-count {
    opacity: 0.6;
    font-size: 11px;
    -unity-text-align: middle-right;
    min-width: 52px;
    margin-right: 2px;
}

.figma-badge {
    font-size: 10px;
    color: var(--unity-colors-default-text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--unity-colors-default-text);
    border-radius: 3px;
    padding: 1px 8px;
    margin: 0 4px;
}

.figma-icon-btn {
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0 0 0 2px;
    font-size: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    color: var(--unity-colors-label-text);
}
.figma-icon-btn:hover { background-color: var(--unity-colors-highlight-background-hover); }

.figma-prop-headrow {
    flex-direction: row;
    align-items: center;
    padding: 0 2px 4px 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}
.figma-prop-head {
    font-size: 10px;
    opacity: 0.7;
    color: var(--unity-colors-label-text);
    padding-left: 2px;
}
.figma-prop-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}
.figma-prop-row--alt { background-color: var(--unity-colors-alternated_rows-background); }
.figma-cell { margin-right: 8px; }
.figma-cell > .unity-base-field { margin: 0; }
.figma-prop-stack > .unity-base-field { margin: 0; }
.figma-cell-fixed {
    width: 22px;
    flex-grow: 0;
    flex-shrink: 0;
}
